# ─────────────────────────────────────────────
# Prism — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────

# ── Supabase (public — safe for client) ──────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (secret — server-only) ──────────
# Only needed for admin actions in Cloudflare Functions.
# NEVER expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App URLs ─────────────────────────────────
# Used for redirects, invite links, CORS, etc.
# Optional. If unset, the app uses the current browser origin.
# Set this in Cloudflare once your custom domain is attached.
VITE_APP_URL=https://prismbudgeting.com

# ── Cloudflare Pages (set in dashboard) ─────
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token
