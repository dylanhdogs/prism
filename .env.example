# Prism environment variables
# Copy this file to .env and fill in your values.

# Supabase public client settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App URL used for auth redirects and invite links.
# Optional. If unset, the app uses the current browser origin.
VITE_APP_URL=https://prismbudgeting.com

# Optional developer admin login helper.
# This must match a real, email-confirmed Supabase Auth user.
VITE_DEV_ADMIN_EMAIL=your-email@example.com

# Invite email provider settings.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Prism <noreply@prismbudgeting.com>

# Server-side Cloudflare Worker integrations. Set these as Worker secrets/vars,
# not in browser-exposed VITE_* values.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# MINDEE_API_KEY=your-mindee-token
# MINDEE_MODEL_ID=your-mindee-receipt-model-id
# MINDEE_RECEIPT_ENDPOINT=https://api-v2.mindee.net/v2/products/extraction/enqueue
# STRIPE_SECRET_KEY=sk_test_...

# Cloudflare Pages dashboard values, if you deploy from the CLI.
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token

# ── Resend (set in API Keys from navigation) ─────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Prism <noreply@prismbudgeting.com>
